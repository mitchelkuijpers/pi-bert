{
  "name": "pi-bert",
  "version": "0.1.0",
  "description": "An animated Bert companion for the Pi coding agent",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "assets/frames",
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "sprites": "bash scripts/slice-sprites.sh",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
